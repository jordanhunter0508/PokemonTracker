<Window x:Class="PokemonCardFinal.View.AddCollectionCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PokemonCardFinal.View"
        mc:Ignorable="d"
        Title="AddCollectionCardWindow" Height="260" Width="240"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>

        <Label x:Name="lblCollecion" Content="Select a Collection to add the card into." Grid.Row="1" Grid.Column="1"/>
        <ComboBox x:Name="cmbCollection" Grid.Row="1" Grid.Column="1" Margin="0 10" Width="150" Height="30"
                  VerticalAlignment="Bottom" VerticalContentAlignment="Center"/>



        <Label x:Name="lblQuantity" Content="Quantity:" Grid.Row="2" Grid.Column="1"
               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="65 0"/>
        <TextBox x:Name="txtQuantity" Grid.Row="2" Grid.Column="1" Width="25" Height="25"
                 VerticalContentAlignment="Center" HorizontalAlignment="Right" Margin="50 0"/>

        <CheckBox x:Name="chkOwned" Content="Do you own the card?" Grid.Row="3" Grid.Column="1"
          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        

        <Button x:Name="btnSave" Content="Save Card" Grid.Row="4" Grid.Column="1"
                Height="30" Width="75" HorizontalAlignment="Left" Click="btnSave_Click"/>
        <Button x:Name="btnCancel" Content="Cancel" Grid.Row="4" Grid.Column="1"
                Height="30" Width="75" HorizontalAlignment="Right" Click="btnCancel_Click"/>

    </Grid>
</Window>
