<Window x:Class="PokemonCardFinal.View.UpdatePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PokemonCardFinal.View"
        mc:Ignorable="d"
        Title="Update Password" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Height="300" Width="450" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="txtInstructions" Grid.ColumnSpan="2" TextWrapping="Wrap"
               TextAlignment="Center" VerticalAlignment="Center">
            Please choose a new password:
            <LineBreak/>
            Must have a capital letter, a lower case letter and a special character.
        </TextBlock>

        <Label x:Name="lblEmail" Grid.Row="1" Margin="10 5 10 5" 
           VerticalContentAlignment="Center" 
           HorizontalContentAlignment="Right">Email:</Label>
        <Label x:Name="lblCurrentPassword" Grid.Row="2" Margin="10 5 10 5" 
           VerticalContentAlignment="Center" 
           HorizontalContentAlignment="Right">Current Password:</Label>
        <Label x:Name="lblNewPassword" Grid.Row="3" Margin="10 5 10 5" 
           VerticalContentAlignment="Center" 
           HorizontalContentAlignment="Right">New Password:</Label>
        <Label x:Name="lblRetypePassword" Grid.Row="4" Margin="10 5 10 5" 
           VerticalContentAlignment="Center" 
           HorizontalContentAlignment="Right">Retype Password:</Label>

        <TextBox x:Name="txtEmail" Grid.Row="1" Grid.Column="1" Margin="10 5 20 5"
             VerticalContentAlignment="Center" 
             HorizontalContentAlignment="Center"/>
        <PasswordBox x:Name="pwdCurrentPassword" Grid.Row="2" Grid.Column="1" Margin="10 5 20 5"
             VerticalContentAlignment="Center" 
             HorizontalContentAlignment="Center"/>
        <PasswordBox x:Name="pwdNewPassword" Grid.Row="3" Grid.Column="1" Margin="10 5 20 5"
             VerticalContentAlignment="Center" 
             HorizontalContentAlignment="Center"/>
        <PasswordBox x:Name="pwdRetypePassword" Grid.Row="4" Grid.Column="1" Margin="10 5 20 5"
             VerticalContentAlignment="Center" 
             HorizontalContentAlignment="Center"/>

        <!-- This makes the two buttons in Grid.Column 1 rather than 1 button in each -->
        <Grid Grid.Row="5" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnSave"  Grid.Column="0" Width="100" Margin="10 5 10 5"
                HorizontalAlignment="Left" FontWeight="Bold" Click="btnSave_Click">Save</Button>
            <Button x:Name="btnCancel" Grid.Column="1" Width="100" Margin="10 5 20 5"
                HorizontalAlignment="Right" FontWeight="Bold" Click="btnCancel_Click">Cancel</Button>
        </Grid>
        <!-- end of button sub-grid -->

        <!--Status Bar for some error messages-->
        <StatusBar Grid.Row="6" Grid.ColumnSpan="2">
            <StatusBarItem x:Name="statMessage" Padding="20 0"/>
        </StatusBar>
    </Grid>
</Window>
