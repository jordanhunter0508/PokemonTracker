<Page x:Class="PokemonCardFinal.View.ListRecords.MoveRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View.ListRecords"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MoveRecordsPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="datMove" Grid.Row="0" SelectionChanged="datMove_SelectionChanged" SelectionMode="Single"
                IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Move Name" Binding="{Binding MoveID}"/>
                <DataGridTextColumn Header="Damage" Binding="{Binding Damage}"/>
                <DataGridTextColumn Header="Element Types" Binding="{Binding ElementTypes}"/>
                <DataGridTextColumn Header="Total Cost" Binding="{Binding TotalCost}"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <Grid Grid.Row="1">
            <Button x:Name="btnEdit" Content="Edit" Width="100" Height="35"
                Margin=" 0 0 120 0" HorizontalAlignment="Right" Click="btnEdit_Click"/>
            <Button x:Name="btnDelete" Content="Delete" Width="100" Height="35"
                HorizontalAlignment="Right" Click="btnDelete_Click"/>
        </Grid>
    </Grid>
</Page>
