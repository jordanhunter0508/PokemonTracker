<Page x:Class="PokemonCardFinal.View.ListRecords.AlternateArtRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View.ListRecords"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Alternate Art List View" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="datAlternate" Grid.Row="0"  SelectionMode="Single" SelectionChanged="datAlternate_SelectionChanged"
                IsReadOnly="True" HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" />
        <Grid Grid.Row="1">
            <Button x:Name="btnEdit" Content="Edit" Width="100" Height="35"
                Margin=" 0 0 120 0" HorizontalAlignment="Right" Click="btnEdit_Click"/>
            <Button x:Name="btnDelete" Content="Delete" Width="100" Height="35"
                HorizontalAlignment="Right" Click="btnDelete_Click"/>
        </Grid>
    </Grid>
</Page>
