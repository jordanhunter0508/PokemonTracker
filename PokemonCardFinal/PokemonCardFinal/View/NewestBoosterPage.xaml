<Page x:Class="PokemonCardFinal.View.NewestBoosterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewestBoosterPage" Loaded="Page_Loaded">

    <Grid>
        <DataGrid x:Name="datCard" SelectionMode="Single" IsReadOnly="True" AutoGenerateColumns="False"
          HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" MouseDoubleClick="datCard_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Card Type" Binding="{Binding CardType}"/>
                <DataGridTextColumn Header="Card Name" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Booster" Binding="{Binding BoosterID}"/>
                <DataGridTextColumn Header="Booster Number" Binding="{Binding BoosterNumber}" />
                <DataGridTextColumn Header="Element" Binding="{Binding ElementTypeID}"/>
                <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}"/>

                <!-- Button Column -->
                <DataGridTemplateColumn x:Name="grdButton">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnCollection" Content="+" Click="btnCollection_Click" VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Page>
