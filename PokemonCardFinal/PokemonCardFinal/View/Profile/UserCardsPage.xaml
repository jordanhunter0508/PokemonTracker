<Page x:Class="PokemonCardFinal.View.Profile.UserCardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View.Profile"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserCardsPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!--Name and description of the collection-->
        <Grid x:Name="grdLabel" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            
            <Label x:Name="lblName" Grid.Column="0"/>
            <TextBlock x:Name="txtDescription" Grid.Column="1" TextWrapping="Wrap"/>
            <Button x:Name="btnDeleteDeck" Content="Delete Deck" Width="100" Height="35" Grid.Column="2" Visibility="Hidden"
                Margin="10 0" HorizontalAlignment="Right" Click="btnDeleteDeck_Click"/>
        </Grid>
        
        <!--Data grid for cards in the collection-->
        <Grid x:Name="grdContent" Grid.Row="1">
            <DataGrid x:Name="datCard" SelectionMode="Single" IsReadOnly="True" SelectionChanged="datCard_SelectionChanged"
                      HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" MouseDoubleClick="datCard_MouseDoubleClick" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Card Type" Binding="{Binding CardType}"/>
                    <DataGridTextColumn Header="Card Name" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Booster" Binding="{Binding BoosterID}"/>
                    <DataGridTextColumn Header="Booster Number" Binding="{Binding BoosterNumber}"/>
                    <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}"/>
                    <DataGridTextColumn Header="Owned" Binding="{Binding Owned}"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!--Disaplays if there are no cards in a collection-->
            <Grid x:Name="grdEmpty" Visibility="Collapsed">
                <TextBlock FontSize="16" Margin="10"
                        Text="You don't have any cards in this collection."/>
                <TextBlock FontSize="16" Margin="10 50"
                        Text="You can add cards to the collection by searching for one or clicking all cards."/>
            </Grid>
        </Grid>
        
        <!--Used to remove a card from the collection-->
        <Grid x:Name="grdButton" Grid.Row="2">
            <Button x:Name="btnRemove" Content="Remove" Width="100" Height="35" Margin="10 0"
                HorizontalAlignment="Right" Click="btnRemove_Click"/>
            <Button x:Name="btnGoBack" Content="Go Back" Width="100" Height="35" Margin="140 0" Visibility="Hidden"
                HorizontalAlignment="Right" Click="btnGoBack_Click"/>
        </Grid>
        
    </Grid>
</Page>
