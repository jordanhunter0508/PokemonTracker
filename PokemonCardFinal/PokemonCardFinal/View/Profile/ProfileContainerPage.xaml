<Page x:Class="PokemonCardFinal.View.Profile.ProfileContainerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View.Profile"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="730"
      Title="Profile Page" Loaded="Page_Loaded">
    <Grid>
        
        <TabControl x:Name="tabController" SelectionChanged="tabController_SelectionChanged">

            <TabItem x:Name="tabUserCard" Header="My Cards">
                <Frame x:Name="frmUserCard"/>
            </TabItem>
            
            <TabItem x:Name="tabUserDeck" Header="My Decks">
                <Frame x:Name="frmUserDeck"/>
            </TabItem>
            
            <TabItem x:Name="tabFavorite" Header="Favorites">
                <Frame x:Name="frmFavorite"/>
            </TabItem>
            
            <TabItem x:Name="tabWishlist" Header="Wishlist">
                <Frame x:Name="frmWishlist"/>
            </TabItem>
            
            <TabItem x:Name="tabAccount" Header="Account Information">
                <Frame x:Name="frmAccount"/>
            </TabItem>

        </TabControl>

    </Grid>
</Page>