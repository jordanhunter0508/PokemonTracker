<Page x:Class="PokemonCardFinal.View.AddRecord.AddAbilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View.AddRecord"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddAbilityPage" Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="150"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Ability Name-->
        <Label x:Name="lblAbilityName" Content="Ability Name:" Grid.Row="0" Grid.Column="0"
            VerticalAlignment="Center"/>
        <TextBox x:Name="txtAbilityName" Grid.Row="0" Grid.Column="0"
        Width="200" Height="25" HorizontalAlignment="Right" VerticalContentAlignment="Center" Margin="0 0 10 0"/>

        <!--Ability Type-->
        <Label x:Name="lblAbilityType" Content="Ability Type:" Grid.Row="1" Grid.Column="0"
            VerticalAlignment="Center"/>
        <TextBox x:Name="txtAbilityType" Grid.Row="1" Grid.Column="0"
        Width="200" Height="25" HorizontalAlignment="Right" VerticalContentAlignment="Center" Margin="0 0 10 0"/>
        
        <!--Ability Description-->
        <Label x:Name="lblDescription" Content="Ability Descripiton:" Grid.Row="2" Grid.Column="0"
            VerticalAlignment="Center"/>
        <TextBox x:Name="txtDescription" Grid.Row="2" Grid.Column="0"
            Width="200" Height="100" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="0 0 10 0"/>
        
        <!--Ability Buttons-->
        <Button x:Name="btnSave" Content="Save" Grid.Row="3" Grid.Column="0"
            Width="100" Height=" 50" HorizontalAlignment="Left" Click="btnSave_Click" />
        <Button x:Name="btnClear" Content="Clear" Grid.Row="3" Grid.Column="0"
            Width="100" Height=" 50"  HorizontalAlignment="Right" Click="btnClear_Click" />

    </Grid>
</Page>
