<Page x:Class="PokemonCardFinal.View.SearchResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="730"
      Title="SearchResultsPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--Filter Boxes-->

        <Grid x:Name="grdFilter" Grid.Row="0">

            <ComboBox x:Name="cmbBooster" Width="150" Height="30" HorizontalAlignment="Left"
                VerticalContentAlignment="Center" SelectionChanged="comboBox_SelectionChanged"/>
            
            <ComboBox x:Name="cmbRarity" Width="150" Height="30" HorizontalAlignment="Left"
                Margin="185 0" VerticalContentAlignment="Center" SelectionChanged="comboBox_SelectionChanged"/>
            
            <ComboBox x:Name="cmbCardType" Width="150" Height="30" HorizontalAlignment="Right"
                Margin="185 0" VerticalContentAlignment="Center" SelectionChanged="comboBox_SelectionChanged"/>

            <ComboBox x:Name="cmbElementType" Width="150" Height="30" HorizontalAlignment="Right"
                VerticalContentAlignment="Center" SelectionChanged="comboBox_SelectionChanged"/>
  
        </Grid>

        <!--Search Results-->
        <Grid x:Name="grdData" Grid.Row="1" Margin="0 10">
            <TextBlock x:Name="lblNoResult" Text="There are no cards with the name." Visibility="Collapsed"/>

            <DataGrid x:Name="datSearch" SelectionMode="Single" IsReadOnly="True" AutoGenerateColumns="False"
                      HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" MouseDoubleClick="datSearch_MouseDoubleClick">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Card Type" Binding="{Binding CardType}"/>
                    <DataGridTextColumn Header="Card Name" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Booster" Binding="{Binding BoosterID}"/>
                    <DataGridTextColumn Header="Booster Number" Binding="{Binding BoosterNumber}" />
                    <DataGridTextColumn Header="Element" Binding="{Binding ElementTypeID}"/>
                    <DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}"/>


                    <!-- Button Column -->
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="btnCollection" Content="+" Click="btnCollection_Click" VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>
        </Grid>
    </Grid>
</Page>
