<Window x:Class="PokemonCardFinal.View.TESTWINDOW"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PokemonCardFinal.View"
        mc:Ignorable="d"
        Title="TESTWINDOW" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        
        <DataGrid x:Name="datGrid" ItemsSource="{Binding}">
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="Moves:" FontWeight="Bold"/>
                        <DataGrid ItemsSource="{Binding Moves}" AutoGenerateColumns="True"/>

                        <TextBlock Text="Alternate Arts:" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding AlternateArts}"/>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <TextBlock x:Name="txtBlock"></TextBlock>

        <!--<DataGrid x:Name="datGrid" Grid.Row="0" SelectionMode="Single" IsReadOnly="True" />-->
    </Grid>
</Window>
