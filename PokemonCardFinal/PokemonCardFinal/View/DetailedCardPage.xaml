<Page x:Class="PokemonCardFinal.View.DetailedCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.View"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="730"
      Title="DetailedCardPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Card Text Grid-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="155"/>
                <RowDefinition Height="175"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--Card Info Grid-->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Label x:Name="lblCardInfo" Grid.Row="0" FontSize="18" Content="Card Info"/>
                <Label x:Name="lblArtist" Grid.Row="2" Margin="10 0" Content="Artist: "/>
                <Label x:Name="lblCardName" Grid.Row="1" Margin="10 0" Content="Card Name"/>
                <Label x:Name="lblRarity" Grid.Row="3" Margin="10 0" Content="Rarity"/>
                <Label x:Name="lblBooster" Grid.Row="4" Margin="10 0" Content="Booster Series: BoosterID, BoosterNumber"/>
            </Grid> <!--End of Card Info Grid-->
            

            <!--Card Stat Grid-->
            <Grid x:Name="grdCardStats" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Label x:Name="lblCardStats" Grid.Row="0" FontSize="16" Content="Card Stats" Margin="10 0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label x:Name="lblHealth" Grid.Row="1" Content="Health: " Margin="10 0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label x:Name="lblStage" Grid.Row="2" Content="Stage: " Margin="10 0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label x:Name="lblWeakness" Grid.Row="3" Content="Weakness: " Margin="10 0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label x:Name="lblResistance" Grid.Row="4" Content="Resistance: " Margin="10 0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label x:Name="lblRetreatCost" Grid.Row="5" Content="Retreat Cost: " Margin="10 0"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid> <!--End of Card Stat Grid-->

            <!--Alternate Art Grid-->
            <Grid x:Name="grdAltArt" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label x:Name="lblAltArt" Grid.Row="0" FontSize="16"  Content="Alternate Arts"/>
                <ListView x:Name="lstAltArt" Grid.Row="1" Width="200" Height="75" Margin="15 10"
                        VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid> <!--End of Alternate Art Grid-->
        </Grid>
        
        
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="140"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--Move Info-->
            <Grid x:Name="grdMove" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Label x:Name="lblMoveTitle" Grid.Row="0" FontSize="18" Content="Moves"/>

                <Label x:Name="lblFirstMove" Grid.Row="1" Margin="10 0" Content="Move Name, cost, (types)"/>
                <TextBlock x:Name="txtFirstMove" Grid.Row="2" Margin="16 0" Text="Description"
                           TextWrapping="Wrap"/>

                <Label x:Name="lblSecondMove" Grid.Row="3" Margin="10 0" Content="Move Name, cost, (types)"/>
                <TextBlock x:Name="txtSecondMove" Grid.Row="4" Margin="16 0" Text="Description"
                           TextWrapping="Wrap"/>
            </Grid>

            <!--Ability Info-->
            <Grid x:Name="grdAbility" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label x:Name="lblAbilityTitle" Grid.Row="0" FontSize="18" Content="Ability"/>
                
                <Label x:Name="lblAbility" Grid.Row="1" Margin="10 0" Content="Ability Name"/>
                <TextBlock x:Name="txtAbility" Grid.Row="2" Margin="16 0" Text="Description"
                           TextWrapping="Wrap"/>

            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnAddCard" Grid.Column="0" Content="Add to Collection" Width="100" Height="50" Margin=" 10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="btnAddCard_Click" />
                <Button x:Name="btnGoBack" Grid.Column="1" Content="Go Back" Width="100" Height="50" Margin=" 10"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="btnGoBack_Click"/>
            </Grid>
        </Grid>
        
    </Grid>
</Page>
