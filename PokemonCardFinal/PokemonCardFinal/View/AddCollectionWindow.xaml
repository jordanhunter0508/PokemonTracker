<Window x:Class="PokemonCardFinal.View.AddCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PokemonCardFinal.View"
        mc:Ignorable="d"
        Title="Create a Collection" Height="260" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label x:Name="lblName" Content="Deck Name" Grid.Column="0" Margin="10"
                    VerticalAlignment="Center" />
            <TextBox x:Name="txtName" Grid.Column="1" Width="150" Height="25" TextWrapping="NoWrap"
                    VerticalContentAlignment="Center"/>
        </Grid>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label x:Name="lblDescription" Content="Description" Grid.Column="0" Margin="10"
                    VerticalAlignment="Center" />
            <TextBox x:Name="txtDescription" Grid.Column="1" Width="150" Height="50" TextWrapping="Wrap"
                    VerticalContentAlignment="Top"/>
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Content="Cancel" Grid.Column="0" Width="50" Height="25" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Save" Grid.Column="1" Width="50" Height="25" Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>
