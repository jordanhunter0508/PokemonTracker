<Page x:Class="PokemonCardFinal.AddView.AddElementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokemonCardFinal.AddView"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddElementPage" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Element Type ID-->
        <Label x:Name="lblElementTypeID" Content="Element Name:" Grid.Row="0" Grid.Column="0"
            VerticalAlignment="Center"/>
        <TextBox x:Name="txtElementTypeID" Grid.Row="0" Grid.Column="0"
                Width="200" Height="25" HorizontalAlignment="Right" VerticalContentAlignment="Center" Margin="0 0 10 0"/>

        <!--Element Description-->
        <Label x:Name="lblDescription" Content="Element Description:" Grid.Row="1" Grid.Column="0"
            VerticalAlignment="Center"/>
        <TextBox x:Name="txtDescription" Grid.Row="1" Grid.Column="0"
                Width="200" Height="75" HorizontalAlignment="Right" TextWrapping="Wrap" Margin="0 0 10 0"/>

        <!--Element Buttons-->
        <Button x:Name="btnSaveElement" Content="Save" Grid.Row="2" Grid.Column="0"
                Width="100" Height=" 50" HorizontalAlignment="Left" Click="btnSaveElement_Click" />
        <Button x:Name="btnClearElement" Content="Clear" Grid.Row="2" Grid.Column="0"
                         Width="100" Height=" 50"  HorizontalAlignment="Right" Click="btnClearElement_Click" />

    </Grid>
</Page>
