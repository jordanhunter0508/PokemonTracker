@model IEnumerable<Website.Models.SeriesWithBoosters>

@{
	ViewData["Title"] = "Admin Panel";
}

<script src="~/js/admin-toggles.js"></script>

<div class="admin-layout-container">

	@* Admin Side bar *@
	<partial name="~/Views/Shared/_AdminPartial.cshtml" />

	@* Main Content *@
	<section>
		<h1>Series and Boosters</h1>
		
		<div class="mb-3 mt-3">
			<a asp-controller="Series" asp-action="Create" class="btn btn-primary">
				Add a new Series
			</a>
		</div>
		@foreach (var item in Model)
		{
			string seriesID = item.Series.SeriesID;

			<div class="admin-card">
				<div class="admin-series-header">
					<h4>@seriesID</h4>


					<div>
						<label class="switch switch-lg">
							<form asp-controller="Series" asp-action="Activate" method="post">
								<input type="hidden" name="id" value="@seriesID" />
								@if (User.IsInRole("Admin"))
								{
									<input type="checkbox" name="active" value="true"
										   @(item.Series.Active ? "checked" : "")
										   onchange="confirmSeries(this,'@seriesID')" />
								}
								else
								{
									<input type="checkbox" name="active" value="true" disabled
										   @(item.Series.Active ? "checked" : "")/>
								}
								<span class="slider"></span>
							</form>
						</label>
					</div>
				</div>

				<div class="mb-3 mt-3">
					<a asp-controller="Booster" asp-action="Create" class="btn btn-primary">
						Add a booster
					</a>
				</div>

				<table class="table">
					<thead>
						<tr>
							<th>
								Booster Name
							</th>
							<th>
								Release Date
							</th>
							<th>
								Abbreviation
							</th>
							<th>
								Base Count
							</th>
							<th>
								Secret Count
							</th>
							<th>
								Total Count
							</th>
							<th>
								Full
							</th>
							<th>
								Active
							</th>
							<th></th>
						</tr>
					</thead>
					<tbody>

						@foreach (var booster in item.Boosters)
						{
							<tr>
								<td>
									@Html.DisplayFor(modelItem => booster.BoosterID)
								</td>
								<td>
									@booster.ReleaseDate.ToString("MM/dd/yyyy")
								</td>
								<td>
									@booster.Abbreviation.ToUpper()
								</td>
								<td>
									@Html.DisplayFor(modelItem => booster.BaseCount)
								</td>
								<td>
									@Html.DisplayFor(modelItem => booster.SecretCount)
								</td>
								<td>
									@Html.DisplayFor(modelItem => booster.TotalCount)
								</td>

								<td>
									@Html.DisplayFor(modelItem => booster.IsFull)
								</td>
								<td>
									<label class="switch switch-sm">
										<form asp-controller="Booster" asp-action="Activate" method="post">
											<input type="hidden" name="id" value="@booster.BoosterID" />
											@if (User.IsInRole("Admin"))
											{
												<input type="checkbox" name="active" value="true"
													   @(booster.Active ? "checked" : "")
													   onchange="confirmBooster(this,'@booster.BoosterID')" />
											}
											else
											{
												<input type="checkbox" name="active" value="true" disabled
													   @(booster.Active ? "checked" : "") />
											}

											<span class="slider"></span>
										</form>
									</label>
								</td>
								<td>
								<div class="d-flex gap-2">
									@Html.ActionLink("View Cards", "AdminList", new { /* id=item.PrimaryKey */ }, new { @class = "btn btn-primary btn-sm" })
									@Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }, new { @class = "btn btn-secondary btn-sm" })
								</div>
								</td>
							</tr>
						}

					</tbody>
				</table>
			</div>
		}
	</section>
</div>