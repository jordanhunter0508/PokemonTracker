@model DataDomain.PokemonRule

@{
    ViewData["Title"] = "Create a Pokemon Rule";
}

<div class="admin-layout-container">
    <partial name="~/Views/Shared/_AdminPartial.cshtml" />

    <section>
        <h1>Create a Pokemon Rule</h1>
            <div class="row">
                <div class="col-md-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="RuleID" class="control-label"></label>
                            <input asp-for="RuleID" class="form-control" />
                            <span asp-validation-for="RuleID" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Description" class="control-label"></label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Create" class="btn btn-primary mt-3" />
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
