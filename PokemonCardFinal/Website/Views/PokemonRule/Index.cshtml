@using Humanizer
@model IEnumerable<DataDomain.PokemonRule>

@{
	ViewData["Title"] = "Pokemon Card Rules";
}

<script src="~/js/admin-toggles.js"></script>

<div class="admin-layout-container">
	<partial name="~/Views/Shared/_AdminPartial.cshtml" />

	<section>
		<h1>Pokemon Card Rules</h1>
		
		<div class="mb-3 mt-3">
			<a asp-controller="PokemonRule" asp-action="Create" class="btn btn-primary">Add a New Card Rule</a>
		</div>

		<table class="table">
				<thead>
					<tr>
						<th>
							@Html.DisplayNameFor(model => model.RuleID)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Description)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Active)
						</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>
								@item.RuleID.Humanize(LetterCasing.Title)
							</td>
							<td>
								@item.Description.Humanize(LetterCasing.Sentence).Truncate(50, "... [more]")
							</td>
							<td>
								<label class="switch switch-sm">
									<form asp-controller="PokemonRule" asp-action="Activate" method="post">
										<input type="hidden" name="id" value="@item.RuleID" />
										<input type="checkbox" name="active" value="true"
											   @(item.Active ? "checked" : "")
											   onchange="confirmGeneralActivate(this,'@item.RuleID')" />
										<span class="slider"></span>
									</form>
								</label>
							</td>
							<td>
								<div class="d-flex gap-2">
									@Html.ActionLink("Details", "Details", new { id = item.RuleID }, new { @class = "btn btn-primary btn-sm" })
									@Html.ActionLink("Edit", "Edit", new { id = item.RuleID }, new { @class = "btn btn-secondary btn-sm" })
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
	</section>
</div>
