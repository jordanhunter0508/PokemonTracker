@using Humanizer
@model DataDomain.PokemonRule

@{
	ViewData["Title"] = "Pokemon Rule Details";
}

<div class="admin-layout-container">
	<partial name="~/Views/Shared/_AdminPartial.cshtml" />

	<section>
		<h1>@Model.RuleID.Humanize(LetterCasing.Title)'s Details</h1>
			<div>
				<dl class="row">
					<dt class="col-sm-2">
						@Html.DisplayNameFor(model => model.RuleID)
					</dt>
					<dd class="col-sm-10">
						@Model.RuleID.Humanize(LetterCasing.Title)
					</dd>
					<dt class="col-sm-2">
						@Html.DisplayNameFor(model => model.Description)
					</dt>
					<dd class="col-sm-10">
						@Html.DisplayFor(model => model.Description)
					</dd>
				</dl>
			</div>
			<div class="mt-4 d-flex gap-2">
				@Html.ActionLink("Edit", "Edit", new { id = Model.RuleID }, new { @class = "btn btn-primary" })
				<a asp-action="Index" class="btn btn-secondary">Back to List</a>
			</div>
	</section>
</div>