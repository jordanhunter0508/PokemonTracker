@using DataDomain
@model DataDomain.CardVM

@{
	ViewData["Title"] = $"{Model.Name} - {Model.BoosterNumber}";
	string baseUrl = "https://pub-0cfa07777fcc4b5381b15a3693771700.r2.dev";
	string fullPath = baseUrl + Model.ImagePath;

	List<string> moveCosts = ViewBag.MoveCosts;

	Booster booster = ViewBag.Booster;
	Ability ability = ViewBag.Ability;
	string artistName = ViewBag.ArtistName;

	// Check if the card has certain components
	bool isPokemon = string.Equals(Model.CardType, "pokemon", StringComparison.OrdinalIgnoreCase);
	bool hasAbility = !string.Equals(Model.AbilityID, "none", StringComparison.OrdinalIgnoreCase);

	// Format strings so the first letter is capitalized
	string elementType = string.Concat(Model.ElementTypeID[0].ToString().ToUpper(), Model.ElementTypeID.AsSpan(1));
	string weaknessType = string.Concat(Model.WeaknessType[0].ToString().ToUpper(), Model.WeaknessType.AsSpan(1));
	string resistanceType = string.Concat(Model.ResistanceType[0].ToString().ToUpper(), Model.ResistanceType.AsSpan(1));
}

@* Navigation back *@
<div>
	<a asp-controller="Card" asp-action="Index">All Cards</a>

	<a asp-controller="Card" asp-action="Index" asp-route-BoosterID="@Model.BoosterID"
	   asp-route-filterTitle="@Model.BoosterID.Replace(" ","-")">
		/ @Model.BoosterID
	</a>
</div>

@* Page Content *@
<section class="card-details-container">

	@* Card Header *@
	<div class="card-details-header">
		<h3>@Model.Name - @Model.BoosterNumber: @Model.BoosterID (@booster.Abbreviation.ToUpper())</h3>
	</div>

	<div class="card-details-content">
		@* Card Image *@
		<div class="card-details-image">
			<img src="@fullPath" alt="@Model.Name" />
		</div>

		@* Card Details *@
		<div class="card-details-info">

			@* Number and Rarity *@
			<div>
				<p><strong>Card Number / Rarity:</strong> @Model.BoosterNumber / @Model.Rarity</p>
			</div>

			@* Card Type and Element Type *@
			<div>
				<p>
					<strong>
						Card Type
						@if (isPokemon)
						{
							<span>/ Pokemon Type:</span>
						}
						else
						{
							<span>:</span>
						}
					</strong>
					@Model.CardType
					@if (isPokemon)
					{
						<span>/ @elementType</span>
					}
				</p>
			</div>

			@* Health and Stage *@
			@if (isPokemon)
			{
				<div>
					<p><strong>Health / Stage: </strong>@Model.Health / @Model.Stage</p>
				</div>
			}


			@* Ability *@
			@if (hasAbility)
			{
				<div>

					@if (Model.CardType.Equals("Pokemon"))
					{
						<p><strong>Ability Name:</strong> @ability.AbilityID</p>
					}
					<p><strong>Ability Description:</strong> @ability.Description</p>
				</div>
			}

			@* Move *@
			@if (Model.Moves.Any())
			{
				<div>
					@for (int i = 0; i < moveCosts.Count; i++)
					{
						<p>
							<strong>Attack @(i + 1):</strong>
							[@moveCosts[i]] @Model.Moves[i].Name (@Model.Moves[i].Damage)
						</p>

						if (!string.Equals(Model.Moves[i].Description,"none",StringComparison.OrdinalIgnoreCase))
						{
							<p>@Model.Moves[i].Description</p>
						}
					}
				</div>
			}


			@* Card Stats *@
			<div>
				<p><strong>Health:</strong> @Model.Health</p>

				@if (Model.WeaknessValue > 0)
				{
					<p><strong>Weakness:</strong> @weaknessType x @Model.WeaknessValue</p>
				}

				@if (Model.ResistanceValue > 0)
				{
					<p><strong>Resistance:</strong> @resistanceType - @Model.ResistanceValue</p>
				}

				<p><strong>Retreat Cost:</strong> @Model.RetreatCost</p>
			</div>

			@* Artist *@
			<div>
				<p>
					<strong>Artist:</strong>
					<a asp-controller="Card" asp-action="Index"
					   asp-route-artistID="@Model.ArtistID"
					   asp-route-filterTitle="@artistName.Replace(",","").Replace(" ","-")'s">
						@artistName
					</a>
				</p>
			</div>

			@if (!Model.AlternateArts.Contains("none"))
			{
				<div>
					<p>Other Varients:</p>
					@foreach (string altArt in Model.AlternateArts)
					{
						<p>@altArt</p>
					}
				</div>
			}
		</div>

	</div>
</section>