@model IEnumerable<Website.Models.SeriesWithBoosters>

@{
	ViewData["Title"] = "Index";

	string baseUrl = "https://pub-0cfa07777fcc4b5381b15a3693771700.r2.dev";
}

<h1>All Boosters</h1>


@foreach (var item in Model)
{
	string seriesImagePath = baseUrl + item.Series.ImagePath;
	<div>
		@* Series Header 
		<div>
			<img src="@seriesImagePath" />
			<span>@item.Series.SeriesID</span>
		</div>*@
		@foreach (var booster in item.Boosters)
		{
			string logo = baseUrl + booster.LogoPath;
			string symbol = baseUrl + booster.SymbolPath;
			<div>
				<span>
					<img src="@logo" alt="@booster.LogoPath"/>
					@if (!booster.SymbolPath.Equals("none"))
					{
						<img src="@symbol" alt="@booster.SymbolPath"/>
					}
					else
					{
						<partial>there is no symbol path stored</partial>	
					}
				</span>
			</div>	
		}
	</div>
}