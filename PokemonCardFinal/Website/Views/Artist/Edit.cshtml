@using Humanizer
@model DataDomain.Artist

@{
    string title = Model.Name;
    ViewData["Title"] = "Edit " + title;
}

<div class="admin-layout-container">
    <partial name="~/Views/Shared/_AdminPartial.cshtml" />

    <section>
        <h1 style="padding: 10px;">Edit @title</h1>
        <hr />
        <div class="admin-card">
            <div class="row">
                <div class="col-md-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input name="id" value="@Model.ArtistID" hidden />
                        <input asp-for="ArtistID" value="@Model.ArtistID" hidden/>

                        <div class="form-group">
                            <label asp-for="GivenName" class="control-label"></label>
                            <input asp-for="GivenName" class="form-control" />
                            <span asp-validation-for="GivenName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Surname" class="control-label"></label>
                            <input asp-for="Surname" class="form-control" />
                            <span asp-validation-for="Surname" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Save" class="btn btn-primary" style="margin-top: 3%;" />
                        </div>
                    </form>
                </div>
            </div>

            <div>
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}