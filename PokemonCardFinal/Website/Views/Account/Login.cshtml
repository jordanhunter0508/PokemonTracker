@model Website.Models.LoginViewModel

@{
	ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center" style="padding-top: 80px; min-height: 100vh;">
	<div class="shadow-sm p-5 rounded-3" style="max-width: 500px; width: 100%; max-height: 500px;background:#f8f9fb">
		<h2 class="text-center mb-4" style="font-family: var(--font-heading);">Login</h2>

		<form asp-controller="Account" asp-action="Login" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="mb-4">
				<label asp-for="Email" class="form-label fw-semibold"></label>
				<input asp-for="Email" class="form-control rounded-2 shadow-sm" />
				<span asp-validation-for="Email" class="text-danger"></span>
			</div>

			<div class="mb-5">
				<label asp-for="Password" class="form-label fw-semibold"></label>
				<input asp-for="Password" class="form-control rounded-2 shadow-sm" />
				<span asp-validation-for="Password" class="text-danger"></span>
			</div>

			<div class="d-grid gap-2 mb-4">
				<input type="submit" value="Login" class="btn btn-primary btn-lg fw-bold" />
			</div>
		</form>

		<div class="text-center">
			<a asp-controller="Account" asp-action="Register" class="text-decoration-none text-muted">
				Don't have an account? <br />
				Sign up
			</a>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}