@using Humanizer
@model DataDomain.ElementType

@{
	string title = Model.ElementTypeID.Humanize(LetterCasing.Title);
	ViewData["Title"] = "Edit " + title;
}

<div class="admin-layout-container">
	<partial name="~/Views/Shared/_AdminPartial.cshtml" />

	<section>
		<h1 style="padding: 10px;">Edit @title</h1>
		<hr />
		<div class="admin-card">
			<div class="row">
				<div class="col-md-4">
					<form asp-action="Edit">
						<input value="@Model.ElementTypeID" name="id" hidden />
						<div asp-validation-summary="ModelOnly" class="text-danger"></div>
						<div class="form-group">
							<label asp-for="ElementTypeID" class="control-label"></label>
							<input class="form-control" value="@Model.ElementTypeID" disabled />
							<input asp-for="ElementTypeID" hidden />
							<span asp-validation-for="ElementTypeID" class="text-danger"></span>
						</div>
						<div class="form-group">
							<label asp-for="Description" class="control-label"></label>
							<input asp-for="Description" class="form-control" />
							<span asp-validation-for="Description" class="text-danger"></span>
						</div>
						<div class="form-group">
							<input type="submit" value="Save" class="btn btn-primary" style="margin-top: 3%;" />
						</div>
					</form>
				</div>
			</div>

			<div>
				<a asp-action="Index">Back to List</a>
			</div>
		</div>
	</section>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}