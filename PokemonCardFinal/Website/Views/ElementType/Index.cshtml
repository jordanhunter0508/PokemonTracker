@using Humanizer
@model IEnumerable<DataDomain.ElementType>

@{
    ViewData["Title"] = "Element Types";
}

<script src="~/js/admin-toggles.js"></script>

<div class="admin-layout-container">
    <partial name="~/Views/Shared/_AdminPartial.cshtml" />

    <section>
        <h1>Element Types</h1>
        
        <div class="mb-3 mt-3">
            <a asp-action="Create" class="btn btn-primary">Add a New Element Type</a>
        </div>

        <table class="table">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.ElementTypeID)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Active)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.ElementTypeID.Humanize(LetterCasing.Title)
                            </td>
                            <td>
                                @item.Description.Humanize(LetterCasing.Sentence).Truncate(50, "... [more]")
                            </td>
                            <td>
                                <label class="switch switch-sm">
                                    <form asp-controller="ElementType" asp-action="Activate" method="post">
                                        <input type="hidden" name="id" value="@item.ElementTypeID" />
                                        <input type="checkbox" name="active" value="true"
                                               @(item.Active ? "checked" : "")
                                               onchange="confirmGeneralActivate(this,'@item.ElementTypeID')" />
                                        <span class="slider"></span>
                                    </form>
                                </label>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    @Html.ActionLink("Details", "Details", new { id = item.ElementTypeID }, new { @class = "btn btn-primary btn-sm" })
                                    @Html.ActionLink("Edit", "Edit", new { id = item.ElementTypeID }, new { @class = "btn btn-secondary btn-sm" })
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
    </section>
</div>