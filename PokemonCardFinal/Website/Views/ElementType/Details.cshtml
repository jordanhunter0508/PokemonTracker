@using Humanizer
@model DataDomain.ElementType

@{
	string title = Model.ElementTypeID.Humanize(LetterCasing.Title);
	ViewData["Title"] = "Element Details";
}

<div class="admin-layout-container">
	<partial name="~/Views/Shared/_AdminPartial.cshtml" />

	<section>
		<h1>@title's Details</h1>
			<div>
				<dl class="row">
					<dt class="col-sm-2">
						@Html.DisplayNameFor(model => model.ElementTypeID)
					</dt>
					<dd class="col-sm-10">
						@title
					</dd>
					<dt class="col-sm-2">
						@Html.DisplayNameFor(model => model.Description)
					</dt>
					<dd class="col-sm-10">
						@Html.DisplayFor(model => model.Description)
					</dd>
				</dl>
			</div>
			<div class="mt-4 d-flex gap-2">
				@Html.ActionLink("Edit", "Edit", new { id = Model.ElementTypeID }, new { @class = "btn btn-primary" })
				<a asp-action="Index" class="btn btn-secondary">Back to List</a>
			</div>
	</section>
</div>