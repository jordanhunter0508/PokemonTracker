@model IEnumerable<DataDomain.Ability>

@{
	ViewData["Title"] = "Deactivated Abilities";
}

<h1>Deactivated Abilities</h1>

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.AbilityID)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.AbilityType)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Description)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.AbilityID)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.AbilityType)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Description)
				</td>
				<td>
					@Html.ActionLink("Activate", "Reactivate", new { id = item.AbilityID }) |
					@Html.ActionLink("Delete", "Delete", new { id = item.AbilityID })
				</td>
			</tr>
		}
	</tbody>
</table>
