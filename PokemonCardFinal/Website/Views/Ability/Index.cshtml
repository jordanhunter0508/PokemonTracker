@using Humanizer
@model IEnumerable<DataDomain.AbilityVM>

@{
	ViewData["Title"] = "Abilities";
}

<script src="~/js/admin-toggles.js"></script>



<div class="admin-layout-container">
	<partial name="~/Views/Shared/_AdminPartial.cshtml" />

	<section>
		<h1>Abilities</h1>
		
		<div class="mb-3 mt-3">
			<a asp-action="Create" class="btn btn-primary">Add a New Ability</a>
		</div>

		<table class="table">
				<thead>
					<tr>
						<th>
							@Html.DisplayNameFor(model => model.AbilityID)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.AbilityType)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.DescriptionDisplay)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Active)
						</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>
								@item.AbilityID.Humanize(LetterCasing.Title)
							</td>
							<td>
								@item.AbilityType.Humanize(LetterCasing.Title)
							</td>
							<td>
								@item.Description.Humanize(LetterCasing.Sentence).Truncate(50, "... [more]")
							</td>
							<td>
								<label class="switch switch-sm">
									<form asp-controller="Ability" asp-action="Activate" method="post">
										<input type="hidden" name="id" value="@item.AbilityID" />
										<input type="checkbox" name="active" value="true"
											   @(item.Active ? "checked" : "")
											   onchange="confirmGeneralActivate(this,'@item.AbilityID')" />
										<span class="slider"></span>
									</form>
								</label>
							</td>
							<td>
								<div class="d-flex gap-2">
									@Html.ActionLink("Details", "Details", new { id = item.AbilityID }, new { @class = "btn btn-primary btn-sm" })
									@Html.ActionLink("Edit", "Edit", new { id = item.AbilityID }, new { @class = "btn btn-secondary btn-sm" })
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
	</section>
</div>
