@model DataDomain.Ability

@{
    ViewData["Title"] = $"Delete {Model.AbilityID}";
}

<h1>Delete @Model.AbilityID</h1>

<h3>
    Are you sure you want to delete this ability?<br/>
    It will be permantly deleted, and cannot be retrived.
</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AbilityID)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AbilityID)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AbilityType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AbilityType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Active)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Active)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="DeactivatedList">Back to List</a>
    </form>
</div>
