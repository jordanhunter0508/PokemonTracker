@using Humanizer
@model DataDomain.Ability

@{
    string capitalTitle = Model.AbilityID.Humanize(LetterCasing.Title);
    ViewData["Title"] = $"Ability Details";
}

<div class="admin-layout-container">
    <partial name="~/Views/Shared/_AdminPartial.cshtml" />

    <section>
        <h1 style="padding: 10px;">@capitalTitle's Details</h1>
        <hr />
        <div class="admin-card">
            <div>
                <dl class="row">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.AbilityID)
                    </dt>
                    <dd class="col-sm-10">
                        @Model.AbilityID.Humanize(LetterCasing.Title)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.AbilityType)
                    </dt>
                    <dd class="col-sm-10">
                        @Model.AbilityType.Humanize(LetterCasing.Title)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Description)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Description)
                    </dd>
                </dl>
            </div>
            <div>
                @Html.ActionLink("Edit", "Edit", new { id = Model.AbilityID }) |
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </section>
</div>