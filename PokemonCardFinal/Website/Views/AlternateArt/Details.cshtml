@using Humanizer
@model DataDomain.AlternateArt

@{
    string capitalTitle = Model.AlternateArtID.Humanize(LetterCasing.Title);
    ViewData["Title"] = "Alternate Art Details";
}



<div class="admin-layout-container">
    <partial name="~/Views/Shared/_AdminPartial.cshtml" />

    <section>
        <h1>@capitalTitle's Details</h1>
            <div>
                <dl class="row">
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.AlternateArtID)
                    </dt>
                    <dd class="col-sm-10">
                        @Model.AlternateArtID.Humanize(LetterCasing.Title)
                    </dd>
                    <dt class="col-sm-2">
                        @Html.DisplayNameFor(model => model.Description)
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.Description)
                    </dd>
                </dl>
            </div>
            <div class="mt-4 d-flex gap-2">
                @Html.ActionLink("Edit", "Edit", new { id = Model.AlternateArtID }, new { @class = "btn btn-primary" })
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
    </section>
</div>