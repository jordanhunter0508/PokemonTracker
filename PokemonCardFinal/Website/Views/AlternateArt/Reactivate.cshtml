@model DataDomain.AlternateArt

@{
    ViewData["Title"] = $"Reactivate {Model.AlternateArtID}";
}

<h1>Reactivate</h1>

<h3>Are you sure you want to reactivate this alternate art?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AlternateArtID)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AlternateArtID)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
    
    <form asp-action="Reactivate">
        <input type="submit" value="Reactivate" class="btn btn-success" /> |
        <a asp-action="DeactivatedList">Back to List</a>
    </form>
</div>
