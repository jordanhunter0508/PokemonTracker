@using Humanizer
@model IEnumerable<DataDomain.AlternateArt>

@{
	ViewData["Title"] = "Alternate Arts";
}

<script src="~/js/admin-toggles.js"></script>

<div class="admin-layout-container">
	<partial name="~/Views/Shared/_AdminPartial.cshtml"/>

	<section>
		<h1 style="padding: 10px;">Alternate Art Types</h1>

		<p>
			<a asp-controller="AlternateArt" asp-action="Create" style="padding: 10px;">
				Add a New Alternate Art
			</a>
		</p>
		<div class="admin-card">
			<table class="table" style="table-layout: fixed; width: 100%">
				<thead>
					<tr>
						<th>
							@Html.DisplayNameFor(model => model.AlternateArtID)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Description)
						</th>
						<th>
							@Html.DisplayNameFor(model => model.Active)
						</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>
								@item.AlternateArtID.Humanize(LetterCasing.Title)
							</td>
							<td style="word-wrap: break-word">
								@item.Description.Humanize(LetterCasing.Sentence).Truncate(50, "... [more]")
							</td>
							<td>
								<label class="switch switch-sm">
									<form asp-controller="AlternateArt" asp-action="Activate" method="post">
										<input type="hidden" name="id" value="@item.AlternateArtID" />
										<input type="checkbox" name="active" value="true"
											   @(item.Active ? "checked" : "")
											   onchange="confirmGeneralActivate(this,'@item.AlternateArtID')" />
										<span class="slider"></span>
									</form>
								</label>
							</td>
							<td>
								@Html.ActionLink("Details", "Details", new { id = item.AlternateArtID }) |
								@Html.ActionLink("Edit", "Edit", new { id = item.AlternateArtID })
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
</div>